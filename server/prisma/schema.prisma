generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  teacher
  admin
}

enum IdeaStatus {
  pending
  under_review
  approved
  rejected
}
enum TeacherApplicationStatus {
  pending
  approved
  rejected
}
model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(student)
  createdAt    DateTime @default(now())

  submittedIdeas Idea[] @relation("IdeaSubmitter")
  reviewedIdeas  Idea[] @relation("IdeaReviewer")
  uploadedIdeas  Idea[] @relation("IdeaUploader")
}

model Idea {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String
  status      IdeaStatus @default(pending)

  submittedById String  @db.Uuid
  uploadedById  String  @db.Uuid
  reviewedById  String? @db.Uuid

  academicYear String
  pdfPath      String
  pdfFileName  String

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  submittedBy User @relation("IdeaSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)

  uploadedBy User @relation("IdeaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  reviewedBy User? @relation("IdeaReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}
model TeacherApplication {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String
  email        String                   @unique
  passwordHash String
  status       TeacherApplicationStatus @default(pending)

  reviewedAt   DateTime?
  reviewedById String?                  @db.Uuid
  rejectionReason String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}